# Copia este archivo como .env.local y completa con los datos de tu proyecto
# Supabase → Project Settings → API (o "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La "anon" key (legacy) o la "publishable" key (sb_publishable_...). Nunca la service_role / secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
